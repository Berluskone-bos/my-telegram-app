# ═══════════════════════════════════════════════════════════
#  АВТОПРОМОЙЛ — TELEGRAM BOT CONFIGURATION
# ═══════════════════════════════════════════════════════════
#
#  Инструкция:
#  1. Получите токен бота у @BotFather (/newbot)
#  2. Узнайте свой Chat ID у @userinfobot
#  3. Настройте Mini App URL в @BotFather (Bot Settings → Mini Apps)
#  4. Заполните значения ниже
#  5. Запустите бота: npm start
#
# ═══════════════════════════════════════════════════════════

# Telegram Bot Token (обязательно)
# Получить: откройте @BotFather → /newbot → скопируйте токен
BOT_TOKEN=

# Chat ID администратора (обязательно для уведомлений)
# Получить: откройте @userinfobot → отправьте любое сообщение → скопируйте ID
ADMIN_CHAT_ID=

# URL вашего Mini App (обязательно)
# Варианты:
#   - Если используете ngrok: https://xxxx.ngrok-free.app
#   - Если используете хостинг: https://your-domain.com
#   - Если используете Telegram Mini App URL: https://t.me/YourBot/AppName
WEB_APP_URL=

# Webhook URL для основного бота (обязательно для production)
# Полный URL: https://your-domain.com/webhook
WEBHOOK_URL=

# Секрет для проверки webhook (обязательно для production)
# Сгенерируйте случайную строку: openssl rand -hex 32
WEBHOOK_SECRET=

# API ключ для админ-панели и курьер-API (обязательно для production)
# Сгенерируйте случайную строку: openssl rand -hex 32
ADMIN_API_KEY=

# Порт веб-сервера (по умолчанию 3000)
PORT=3000

# Дополнительные токены для курьер-бота и админ-бота (опционально)
# COURIER_BOT_TOKEN=
# ADMIN_BOT_TOKEN=

# Яндекс Геокодер API ключ (опционально)
# YANDEX_GEO_KEY=
